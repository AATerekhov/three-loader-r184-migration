{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "build/declarations",
    "rootDir": "./src",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "alwaysStrict": true,
    "target": "ES2020",
    "experimentalDecorators": true,
    "typeRoots": ["node_modules/@types"],
    "lib": ["ES2020", "DOM"],
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["build", "node_modules"]
}
